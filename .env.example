# TalentScout AI - environment template
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# Never commit the real `.env` - it is gitignored for a reason.

# ---- OpenAI (required) ----
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Default model for all LLM calls.
# gpt-4o-mini is the cheapest capable option (~$0.002 per full interview).
# Step up to gpt-4.1-mini if you want stricter scoring.
OPENAI_MODEL=gpt-4o-mini

# ---- Optional: per-task model routing ----
# Leave unset to use OPENAI_MODEL for everything.
# Useful if you want cheap question generation but sharper evaluation.
# OPENAI_MODEL_QUESTIONS=gpt-4o-mini
# OPENAI_MODEL_EVALUATION=gpt-4.1-mini
# OPENAI_MODEL_REPORT=gpt-4.1-mini

# ---- Request reliability ----
# Retries use exponential backoff with jitter and honour Retry-After.
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=3

# ---- Persistence ----
# Any SQLAlchemy URL. The default is a local SQLite file, created on first run.
# Point this at Postgres for a deployment whose data must survive a restart.
# DATABASE_URL=sqlite:///data/talentscout.db
# DATABASE_ECHO=False

# ---- Recruiter dashboard ----
# Leave unset for local use and the dashboard is open. SET THIS on any public
# deployment: the dashboard shows candidate names, emails and phone numbers.
# RECRUITER_PASSWORD=

# ---- Application settings ----
DEBUG_MODE=False
APP_ENV=development

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=logs/talentscout.log
